762\u89c4\u5219\u7684\u5f3a\u5bc6\u7801 \u7ba1\u7406\u5458\u90ae\u7bb1 \u7ba1\u7406\u53f0\u767b\u5f55\u90ae\u7bb1\uff08\u9009\u586b\uff09 \u53ef\u7559\u7a7a\uff0c\u90e8\u7f72\u540e\u53ef\u5728\u754c\u9762\u67e5\u770b/\u4fee\u6539 \u5b9e\u4f8b\u5bc6\u7801 ECS \u767b\u5f55\u5bc6\u7801 \u4f7f\u7528\u7b26\u5408\u9875\u9762\u89c4\u5219\u7684\u5f3a\u5bc6\u7801 \u4e13\u6709\u7f51\u7edc \u65b0\u5efa\u6216\u590d\u7528 VPC \u9996\u6b21\u90e8\u7f72\u53ef\u9009\u62e9\u65b0\u5efa VPC/\u4ea4\u6362\u673a\u7f51\u6bb5 \u7f51\u7edc\u5730\u5740\u8303\u56f4 \u65e0\u51b2\u7a81\u65f6\u4fdd\u6301\u9ed8\u8ba4 \u7cfb\u7edf\u76d8\u7c7b\u578b ECS \u7cfb\u7edf\u76d8 \u9ed8\u8ba4 cloud_essd \u7ba1\u7406\u5458\u5bc6\u7801\u5728\u90e8\u7f72\u65f6\u8bbe\u7f6e\uff0c\u8bf7\u52ff\u4f7f\u7528\u5f31\u5bc6\u7801\uff0c\u4e5f\u4e0d\u8981\u5c06\u5bc6\u7801\u5199\u5165\u6587\u6863\u6216\u4ee3\u7801\u4ed3\u5e93\u3002 \u586b\u5199\u5b8c\u6210\u5e76\u770b\u5230\u8be2\u4ef7\u7ed3\u679c\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\uff1a\u786e\u8ba4\u8ba2\u5355\u201d\uff0c\u6838\u5bf9\u8d44\u6e90\u548c\u8d39\u7528\uff0c\u52fe\u9009\u670d\u52a1\u534f\u8bae\u5e76\u521b\u5efa\u5b9e\u4f8b\u3002","title":"2. \u914d\u7f6e\u90e8\u7f72\u53c2\u6570"},{"location":"#3","text":"\u8fdb\u5165\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\uff0c\u7b49\u5f85\u72b6\u6001\u53d8\u4e3a\u201c\u5df2\u90e8\u7f72\u201d\u3002\u672c\u6b21\u5b9e\u6d4b\u4ece\u521b\u5efa\u5230\u90e8\u7f72\u5b8c\u6210\u7ea6 3 \u5206\u949f\u3002","title":"3. \u7b49\u5f85\u90e8\u7f72\u5b8c\u6210"},{"location":"#4","text":"\u5728\u5b9e\u4f8b\u8be6\u60c5\u9875\u300c\u7acb\u5373\u4f7f\u7528\u300d\u533a\u57df\u6253\u5f00\u8bbf\u95ee\u5730\u5740\u3002 \u6253\u5f00\u8bbf\u95ee\u5730\u5740\uff0c\u4f7f\u7528\u90e8\u7f72\u53c2\u6570\u4e2d\u7684\u7ba1\u7406\u5458\u90ae\u7bb1\u548c\u5bc6\u7801\u767b\u5f55\uff0c\u518d\u5728\u7ba1\u7406\u53f0\u914d\u7f6e\u6a21\u578b\u670d\u52a1\u4e0e\u804a\u5929\u5e73\u53f0\u51ed\u636e\uff1b\u5982\u9700\u5e73\u53f0\u53cd\u5411\u8fde\u63a5\u62