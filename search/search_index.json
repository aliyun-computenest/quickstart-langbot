\u8ba1\u7b97\u5de2\u90e8\u7f72\u6587\u6863 \u6982\u8ff0 LangBot \u662f\u9762\u5411 LLM \u65f6\u4ee3\u7684\u5f00\u6e90\u5373\u65f6\u901a\u8baf\u673a\u5668\u4eba\u5e73\u53f0\uff0c\u652f\u6301\u901a\u8fc7 Web \u7ba1\u7406\u53f0\u8fde\u63a5\u767e\u70bc\u3001\u901a\u4e49\u3001DeepSeek \u7b49\u6a21\u578b\u670d\u52a1\uff0c\u5e76\u63a5\u5165\u9489\u9489\u3001\u98de\u4e66\u3001\u4f01\u4e1a\u5fae\u4fe1\u3001Telegram\u3001Discord \u7b49\u6e20\u9053\uff0c\u9002\u5408\u5feb\u901f\u6784\u5efa\u548c\u8fd0\u7ef4\u591a\u5e73\u53f0 AI \u52a9\u624b\u3002\u672c\u65b9\u6848\u5c06\u5176\u90e8\u7f72\u5728\u7528\u6237\u81ea\u5df1\u7684 ECS \u4e2d\u3002 \u9879\u76ee \u8bf4\u660e \u670d\u52a1 ID service-b13f3c3704cf4b369741 \u90e8\u7f72\u5f62\u6001 \u5355\u53f0 ECS + Docker Compose \u8bbf\u95ee\u65b9\u5f0f \u516c\u7f51\u8bbf\u95ee\u7ba1\u7406\u53f0 \u5e94\u7528\u7aef\u53e3 5300\uff08Web \u7ba1\u7406\u53f0\uff09 Webhook \u7aef\u53e3 2280-2285\uff08\u5e73\u53f0\u53cd\u5411\u8fde\u63a5\u6309\u9700\u653e\u884c\uff09 \u5b9e\u6d4b\u90e8\u7f72\u8017\u65f6 \u7ea6 3 \u5206\u949f \u90e8\u7f72\u6b65\u9aa4 1. \u6253\u5f00\u521b\u5efa\u9875\u9762 \u8bbf\u95ee LangBot \u670d\u52a1\u5b9e\u4f8b\u521b\u5efa\u9875 \u3002 2. \u914d\u7f6e\u90e8\u7f72\u53c2\u6570 \u53c2\u6570 \u8bf4\u660e \u5efa\u8bae \u670d\u52a1\u5b9e\u4f8b\u540d\u79f0 \u63a7\u5236\u53f0\u4e2d\u7528\u4e8e\u8bc6\u522b\u672c\u6b21\u90e8\u7f72 \u4fdd\u6301\u9ed8\u8ba4\u6216\u81ea\u5b9a\u4e49 \u5730\u57df\u3001\u53ef\u7528\u533a ECS \u6240\u5728\u4f4d\u7f6e \u9009\u62e9\u63a5\u8fd1\u4f7f\u7528\u8005\u4e14\u6709\u5e93\u5b58\u7684\u5730\u57df\u548c\u53ef\u7528\u533a \u4ed8\u8d39\u7c7b\u578b \u6309\u91cf\u4ed8\u8d39\u6216\u5305\u5e74\u5305\u6708 \u6d4b\u8bd5\u4f7f\u7528\u6309\u91cf\u4ed8\u8d39 \u5b9e\u4f8b\u7c7b\u578b ECS \u89c4\u683c \u63d0\u4f9b 3 \u79cd\u901a\u7528\u7b97\u529b\u578b u1 \u89c4\u683c \u7ba1\u7406\u5458\u5bc6\u7801 Web \u7ba1\u7406\u53f0\u767b\u5f55\u5bc6\u7801 \u4f7f\u7528\u7b26\u5408\u9875\u9762\u89c4\u5219\u7684\u5f3a\u5bc6\u7801 \u7ba1\u7406\u5458\u90ae\u7bb1 \u7ba1\u7406\u53f0\u767b\u5f55\u90ae\u7bb1\uff08\u9009\u586b\uff09 \u53ef\u7559\u7a7a\uff0c\u90e8\u7f72\u540e\u53ef\u5728\u754c\u9762\u67e5\u770b/\u4fee\u6539 \u5b9e\u4f8b\u5bc6\u7801 ECS \u767b\u5f55\u5bc6\u7801 \u4f7f\u7528\u7b26\u5408\u9875\u9762\u89c4\u5219\u7684\u5f3a\u5bc6\u7801 \u4e13\u6709\u7f51\u7edc \u65b0\u5efa\u6216\u590d\u7528 VPC \u9996\u6b21\u90e8\u7f72\u53ef\u9009\u62e9\u65b0\u5efa VPC/\u4ea4\u6362\u673a\u7f51\u6bb5 \u7f51\u7edc\u5730\u5740\u8303\u56f4 \u65e0\u51b2\u7a81\u65f6\u4fdd\u6301\u9ed8\u8ba4 \u7cfb\u7edf\u76d8\u7c7b\u578b ECS \u7cfb\u7edf\u76d8 \u9ed8\u8ba4 cloud_essd \u7ba1\u7406\u5458\u5bc6\u7801\u5728\u90e8\u7f72\u65f6\u8bbe\u7f6e\uff0c\u8bf7\u52ff\u4f7f\u7528\u5f31\u5bc6\u7801\uff0c\u4e5f\u4e0d\u8981\u5c06\u5bc6\u7801\u5199\u5165\u6587\u6863\u6216\u4ee3\u7801\u4ed3\u5e93\u3002 \u586b\u5199\u5b8c\u6210\u5e76\u770b\u5230\u8be2\u4ef7\u7ed3\u679c\u540e\uff0c\u70b9\u51fb\u201c\u4e0b\u4e00\u6b65\uff1a\u786e\u8ba4\u8ba2\u5355\u201d\uff0c\u6838\u5bf9\u8d44\u6e90\u548c\u8d39\u7528\uff0c\u52fe\u9009\u670d\u52a1\u534f\u8bae\u5e76\u521b\u5efa\u5b9e\u4f8b\u3002 3. \u7b49\u5f85\u90e8\u7f72\u5b8c\u6210 \u8fdb\u5165\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\uff0c\u7b49\u5f85\u72b6\u6001\u53d8\u4e3a\u201c\u5df2\u90e8\u7f72\u201d\u3002\u672c\u6b21\u5b9e\u6d4b\u4ece\u521b\u5efa\u5230\u90e8\u7f72\u5b8c\u6210\u7ea6 3 \u5206\u949f\u3002 4. \u8fdb\u5165\u5e94\u7528 \u5728\u5b9e\u4f8b\u8be6\u60c5\u9875\u300c\u7acb\u5373\u4f7f\u7528\u300d\u533a\u57df\u6253\u5f00\u8bbf\u95ee\u5730\u5740\u3002 \u6253\u5f00\u8bbf\u95ee\u5730\u5740\uff0c\u4f7f\u7528\u90e8\u7f72\u53c2\u6570\u4e2d\u7684\u7ba1\u7406\u5458\u90ae\u7bb1\u548c\u5bc6\u7801\u767b\u5f55\uff0c\u518d\u5728\u7ba1\u7406\u53f0\u914d\u7f6e\u6a21\u578b\u670d\u52a1\u4e0e\u804a\u5929\u5e73\u53f0\u51ed\u636e\uff1b\u5982\u9700\u5e73\u53f0\u53cd\u5411\u8fde\u63a5\u6216 Webhook\uff0c\u5728\u5b89\u5168\u7ec4\u6309\u9700\u653e\u884c 2280-2285 \u7aef\u53e3\u5e76\u914d\u7f6e\u516c\u7f51\u56de\u8